# Edify platform: DEVELOPMENT configuration template.
# Copy to platform/.env (ignored by git) and fill in. Never put a production
# value in this file or in a copy of it.

# ── Go gateway ───────────────────────────────────────────────────────────────
# development | test | staging. "production" is refused by this build.
EDIFY_ENV=development
EDIFY_HTTP_ADDR=127.0.0.1:8090

# The gateway reads ONLY this variable for its database. DATABASE_URL (the
# existing application's) is never consulted. Connect as the read-only role
# created by deploy/db/apply-roles.sh.
EDIFY_DATABASE_URL=postgresql://edify_gateway@localhost:5432/edify_gorn_dev

# Development and test accept this machine only. Staging must list its
# database host here explicitly, and requires TLS.
EDIFY_DB_ALLOWED_HOSTS=
# Extra substrings that identify the production database (its exact hostname).
# A URL containing one is refused in every environment.
EDIFY_DB_PRODUCTION_MARKERS=

# Must equal the JWT_SECRET of the existing application IN THE SAME
# ENVIRONMENT (the worktree's own .env for development). Generate with:
#   openssl rand -hex 40
EDIFY_JWT_SECRET=

# Browser origins allowed to call the gateway. Empty sends no CORS headers,
# which is right for the native app. Only the app's web build needs it. No
# wildcards; https only in staging.
EDIFY_CORS_ALLOWED_ORIGINS=http://localhost:8082

# The existing Edify application of the SAME environment. The gateway asks it
# for the screens whose rules have not been ported to Go yet. Local only in
# development; https in staging; the production site is refused.
EDIFY_EXISTING_APP_URL=http://localhost:8010

# Internal address of the Python analytics worker. Leave empty to run without.
EDIFY_ANALYTICS_ADDR=127.0.0.1:50061

# ── Mobile app (read by Expo at build time) ──────────────────────────────────
# development | staging. Anything else, and any edifyplanning.app host, is
# refused by the app at startup.
EXPO_PUBLIC_EDIFY_ENV=development
EXPO_PUBLIC_EDIFY_GATEWAY_URL=http://localhost:8090
EXPO_PUBLIC_EDIFY_IDENTITY_URL=http://localhost:8000
