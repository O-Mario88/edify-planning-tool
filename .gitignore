# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtualenv
.venv/
venv/
env/

# Local env
.env
.env.local

# Django
staticfiles/
media/
*.log
db.sqlite3

# Evidence storage (runtime)
uploads/

# Coverage
.coverage
htmlcov/

# OS
.DS_Store

# Local ZCode agent config (skills, etc.)
.agents/

# Node (CSS build pipeline). The lockfile IS committed: it is what makes
# `npm ci` possible and the CSS build reproducible, and without it every
# install resolves the tree afresh — so the bundle CI verifies is not
# necessarily the bundle anyone else would produce.
node_modules/

# Agent/tooling debris that should never reach the repo.
# _to_delete_git_locks holds empty git .lock files left behind by a crashed
# operation; committing them can wedge a later clone's git operations.
_to_delete_git_locks/
.zcode/
referential-integrity-backup*.json
.backup-rehearsal/
