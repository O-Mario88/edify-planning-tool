# Environment template for the Edify API (Django). Copy to `.env` and fill in.
# Every variable here is actually read by config/settings/base.py or prod.py —
# see DEPLOY.md for the full production table.

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Either a single URL…
DATABASE_URL=postgresql://edify:YOUR_PASSWORD@localhost:5432/edify_pm
# …or discrete parts (used by docker-compose to build its own URL):
POSTGRES_USER=edify
POSTGRES_PASSWORD=                # REQUIRED — set a strong password
POSTGRES_DB=edify_pm
DB_PORT=5432

# ── Secrets (REQUIRED in production; prod refuses to boot without them) ─────
# Django/App Platform convention. JWT_SECRET below remains supported; when it
# is omitted the JWT layer uses this same secret.
# Strong secret, ≥50 chars, must NOT contain "change-me"/"dev-only".
# Generate one:  openssl rand -hex 32
SECRET_KEY=
# Strong secret, ≥50 chars, must NOT contain "change-me"/"dev-only".
# Generate one:  openssl rand -hex 32
JWT_SECRET=
# 32-byte hex/base64 key for AES-256-GCM field-level encryption.
# Generate one:  openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
# The one bootstrap account that ships to production (created/updated by
# `manage.py seed`). Gets app Admin role + Django /admin/ access.
SUPER_ADMIN_EMAIL=edwin.omario@gmail.com
SUPER_ADMIN_PASSWORD=             # REQUIRED — strong secret

# ── Production gates (prod.py fails closed on wrong values) ─────────────────
# Must be "enforce" in production. "shadow" is for local development only.
AUTHZ_MODE=enforce
# Private DigitalOcean Spaces bucket for every durable user upload.
# Create a bucket-scoped key with Read/Write/Delete access. Keep the bucket
# and its objects private; the application authorizes and streams downloads.
SPACES_BUCKET_NAME=
SPACES_REGION=             # e.g. nyc3, sfo3, fra1, sgp1
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Optional; derived as https://${SPACES_REGION}.digitaloceanspaces.com.
SPACES_ENDPOINT_URL=
# Optional key prefix so environments can share a bucket safely.
SPACES_PREFIX=edify
# Bounded network behaviour for upload/download requests.
SPACES_CONNECT_TIMEOUT_SECONDS=5
SPACES_READ_TIMEOUT_SECONDS=30
SPACES_MAX_ATTEMPTS=3
SPACES_MAX_POOL_CONNECTIONS=20
# DigitalOcean App Platform domain. In the control panel, set this value to
# the platform's ${APP_DOMAIN} bindable variable. The code adds the resulting
# hostname and its HTTPS CSRF origin.
DIGITALOCEAN_APP_DOMAIN=
# Comma-separated custom/real hosts. In prod, required unless
# DIGITALOCEAN_APP_DOMAIN is present.
ALLOWED_HOSTS=
# Comma-separated HTTPS origins for custom domains, including the scheme.
CSRF_TRUSTED_ORIGINS=
# All of these MUST be false in production (prod.py refuses to boot otherwise).
# ENABLE_DEV_SEED=true enables `seed --demo` locally — flip it only in local dev.
ENABLE_MOCK_DATA=false
ENABLE_DEV_ENDPOINTS=false
ENABLE_DEV_SEED=false
ENABLE_DEV_IMPORTS=false
PARTNER_ROLE_BRIDGE=false

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Public URL(s) of any cross-origin client, comma-separated (CORS).
CORS_ORIGINS=
# Run `manage.py seed` on container start (reference data only; idempotent).
# Set true for the first deploy, then back to false.
RUN_SEED=false
# The 8 scheduled jobs only run in the dedicated `manage.py runscheduler`
# process — set true THERE (and in local dev if you want jobs).
ENABLE_BACKGROUND_JOBS=false

# ── Optional ─────────────────────────────────────────────────────────────────
# Redis cache (falls back to in-process LocMem if unset/unreachable).
REDIS_URL=
# Optional outbound email is not required for login or in-app messaging.
# Keep "console" unless a future release explicitly enables external email.
# Analytics schedules deliver to Messages + Notifications, not email.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# The console mailer withholds message bodies by default -- they carry live
# invitation links and sign-in codes, which outlive the email in a log stream.
# Set to 1 locally to read them; refused in production regardless.
EMAIL_LOG_BODIES=
# SMS -- one of the two channels a two-step verification code can arrive on.
# "console" logs nothing deliverable; "africastalking" needs BOTH credentials.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=
SMS_LOG_BODIES=
# Two-step verification is per user (Settings -> Two-step verification). Set
# this to require it on every account instead.
MFA_REQUIRED_FOR_ALL=
# Sessions end after this many seconds of INACTIVITY. The window slides forward
# while someone is working -- see docs/session-and-mfa-policy.md.
SESSION_IDLE_TIMEOUT_SECONDS=1800
# ClamAV daemon for evidence-upload malware scanning (skipped if unset).
CLAMAV_HOST=
CLAMAV_PORT=3310
# Local development only — shared password for `seed --demo` accounts.
DEMO_LOGIN_PASSWORD=edify
